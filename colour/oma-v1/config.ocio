ocio_profile_version: 2.1

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: Oma Colour 1
description: Oma creative suite colour contract v1. Linear Rec.709 interchange; Standard preserves sRGB artwork. No tone mapping is baked into documents.

roles:
  aces_interchange: ACES2065-1
  color_picking: sRGB
  data: Raw
  default: sRGB
  matte_paint: sRGB
  oma_interchange: Linear Rec.709
  scene_linear: Linear Rec.709
  texture_paint: sRGB

file_rules:
  - !<Rule> {name: Default, colorspace: sRGB}

displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB}
    - !<View> {name: Linear diagnostic, colorspace: Linear Rec.709}

active_displays: [sRGB]
active_views: [Standard, Linear diagnostic]

colorspaces:
  - !<ColorSpace>
    name: Linear Rec.709
    family: ""
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: scene-linear
    allocation: uniform

  - !<ColorSpace>
    name: sRGB
    family: ""
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    encoding: sdr-video
    allocation: uniform
    to_scene_reference: !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055}

  - !<ColorSpace>
    name: ACES2065-1
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: false
    encoding: scene-linear
    allocation: uniform
    to_scene_reference: !<GroupTransform>
      children:
        - !<BuiltinTransform> {style: UTILITY - ACES-AP0_to_CIE-XYZ-D65_BFD}
        - !<MatrixTransform> {matrix: [0.41239079926596, 0.357584339383878, 0.180480788401834, 0, 0.212639005871510, 0.715168678767756, 0.0721923153607337, 0, 0.0193308187155918, 0.119194779794626, 0.950532152249661, 0, 0, 0, 0, 1], direction: inverse}

  - !<ColorSpace>
    name: Raw
    family: ""
    equalitygroup: ""
    bitdepth: unknown
    isdata: true
    allocation: uniform
