+// OmaRAW colour adapter ABI 1. Registered before any image is processed.
+// Matrix rows have four floats; only the upper 3x3 is colour. A null matrix
+// means identity. LUTs/coefficients are borrowed for this call only.
+#pragma once
+#include <stddef.h>
+typedef void (*dt_omaraw_ocio_callback)(const float *input, float *output, int width, int height,
+                                      const float *matrix, const float *const lut[3],
+                                      const float *coefficients, int lutsize, int curves_before);
+extern dt_omaraw_ocio_callback dt_omaraw_ocio_transform;
+void dt_omaraw_set_ocio_transform(dt_omaraw_ocio_callback callback);
+static inline int dt_omaraw_ocio_apply(const float *input, float *output, int width, int height,
+                                      const float *matrix, const float *const lut[3],
+                                      const float *coefficients, int lutsize, int curves_before)
+{
+  if(!dt_omaraw_ocio_transform) return 0;
+  dt_omaraw_ocio_transform(input, output, width, height, matrix, lut, coefficients, lutsize, curves_before);
+  return 1;
+}
