+// A camera profile's tables, by file. OmaRAW names each bake after its
+// contents, so a file once read never changes: kept for the session, like
+// the stocks, and tried again a little later when it could not be read.
+static GHashTable *g_profiles;       // path -> omaraw_print_tables_t*
+static GHashTable *g_profile_failed; // path -> when it last could not be read
+static const omaraw_print_tables_t *_load_profile(const char *path)
+{
+  if(!path || !*path) return NULL;
+  g_mutex_lock(&g_load_lock);
+  if(!g_profiles)
+  {
+    g_profiles = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);
+    g_profile_failed = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+  }
+  const omaraw_print_tables_t *t = g_hash_table_lookup(g_profiles, path);
+  const gint64 *failed = t ? NULL : g_hash_table_lookup(g_profile_failed, path);
+  if(!t && (!failed || g_get_monotonic_time() - *failed > 2 * G_USEC_PER_SEC))
+  {
+    omaraw_print_tables_t *n = calloc(1, sizeof(*n));
+    if(n && _read_tables(path, n))
+    {
+      g_hash_table_insert(g_profiles, g_strdup(path), n);
+      g_hash_table_remove(g_profile_failed, path);
+      t = n;
+    }
+    else
+    {
+      free(n);
+      gint64 *when = g_new(gint64, 1);
+      *when = g_get_monotonic_time();
+      g_hash_table_insert(g_profile_failed, g_strdup(path), when);
+    }
+  }
+  g_mutex_unlock(&g_load_lock);
+  return t;
+}
