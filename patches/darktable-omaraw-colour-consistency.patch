+// The bridge requests float linear Rec.709 for every view and writer. Blend
+// two complete paths there, after all tools and before the display/output
+// transform. Piece flags and cache keys are private to this pipe; history
+// and the module enabled flags are never changed by rendering.
+static int _omaraw_tone_bit(const char *op)
+{
+  return !strcmp(op, "sigmoid") ? 1 : !strcmp(op, "filmicrgb") ? 2 : !strcmp(op, "basecurve") ? 4 : 0;
+}
+
+static int _omaraw_print_legacy_base(const dt_develop_t *dev, const dt_iop_module_t *print)
+{
+  int state = 0, baseline = 0, i = 0;
+  gboolean printing = FALSE;
+  for(GList *n = dev->iop; n; n = n->next)
+  {
+    const dt_iop_module_t *m = n->data;
+    if(m->default_enabled) state |= _omaraw_tone_bit(m->op);
+  }
+  for(GList *n = dev->history; n && i < dev->history_end; n = n->next, ++i)
+  {
+    const dt_dev_history_item_t *h = n->data;
+    if(h->module == print)
+    {
+      if(h->enabled && !printing) baseline = state;
+      printing = h->enabled;
+    }
+    const int bit = _omaraw_tone_bit(h->op_name);
+    state = h->enabled ? state | bit : state & ~bit;
+  }
+  return printing ? baseline : state;
+}
+
+int dt_omaraw_print_base_tone(const dt_develop_t *dev, const dt_iop_module_t *print)
+{
+  const int *saved = print->so->get_p ? print->so->get_p(print->params, "base_tone") : NULL;
+  return saved && *saved >= 0 ? *saved & 7 : _omaraw_print_legacy_base(dev, print);
+}
+
+static gboolean _omaraw_process_print(dt_dev_pixelpipe_t *pipe, dt_develop_t *dev,
+                                      void **buf, void **cl_buf, dt_iop_buffer_dsc_t **format,
+                                      const dt_iop_roi_t *roi, GList *modules, GList *pieces, const int pos)
+{
+  dt_dev_pixelpipe_iop_t *print = NULL;
+  for(GList *n = pipe->nodes; n; n = n->next)
+  {
+    dt_dev_pixelpipe_iop_t *p = n->data;
+    if(p->enabled && !strcmp(p->module->op, "omarawprint")) { print = p; break; }
+  }
+  const oma_print_blend_t *blend = print ? print->data : NULL;
+  if(!blend || blend->strength >= 1.f)
+    return _dev_pixelpipe_process_rec_and_backcopy(pipe, dev, buf, cl_buf, format, roi, modules, pieces, pos);
+
+  const float mix = CLAMP(blend->strength, 0.f, 1.f);
+  const int baseline = blend->base_tone >= 0 ? blend->base_tone & 7 : _omaraw_print_legacy_base(dev, print->module);
+  const int count = g_list_length(pipe->nodes);
+  gboolean *enabled = g_new(gboolean, count);
+  int i = 0;
+  for(GList *n = pipe->nodes; n; n = n->next, ++i)
+  {
+    dt_dev_pixelpipe_iop_t *p = n->data;
+    enabled[i] = p->enabled;
+    const int bit = _omaraw_tone_bit(p->module->op);
+    if(bit) p->enabled = (baseline & bit) != 0;
+    if(p == print) p->enabled = FALSE;
+  }
+  gboolean error = _dev_pixelpipe_process_rec_and_backcopy(pipe, dev, buf, cl_buf, format, roi, modules, pieces, pos);
+  i = 0;
+  for(GList *n = pipe->nodes; n; n = n->next, ++i)
+    ((dt_dev_pixelpipe_iop_t *)n->data)->enabled = enabled[i];
+  g_free(enabled);
+  if(error || mix == 0.f) return error;
+  // OmaRAW's output adapter guarantees this format. Do not interpret a
+  // non-float third-party caller's buffer as floats.
+  if((*format)->datatype != TYPE_FLOAT || (*format)->channels != 4) return TRUE;
+  const size_t samples = (size_t)roi->width * roi->height * 4;
+  pipe->omaraw_print_buffer = dt_alloc_align_float(samples);
+  if(!pipe->omaraw_print_buffer) return TRUE;
+  memcpy(pipe->omaraw_print_buffer, *buf, samples * sizeof(float));
+  error = _dev_pixelpipe_process_rec_and_backcopy(pipe, dev, buf, cl_buf, format, roi, modules, pieces, pos);
+  if(error) return TRUE;
+  if((*format)->datatype != TYPE_FLOAT || (*format)->channels != 4) return TRUE;
+  const float *printed = *buf;
+  float *plain = pipe->omaraw_print_buffer;
+  DT_OMP_FOR()
+  for(size_t k = 0; k < samples; ++k) plain[k] += mix * (printed[k] - plain[k]);
+  *buf = plain;
+  return FALSE;
+}
