+// These hidden technical/profile stages need completed chromatic adaptation.
+// Repair only missing stages or the early positions shipped before this fix;
+// retain already-valid custom ordering and every other module's relative order.
+// The migration API keeps the list head by value, so rotate data pointers when
+// moving an existing entry rather than removing a possibly first list node.
+static void _omaraw_ensure_after(GList *list, const char *anchor_op, const char *op)
+{
+  GList *anchor = NULL, *node = NULL;
+  int anchor_index = -1, index = -1, i = 0;
+  for(GList *n = list; n; n = n->next, ++i)
+  {
+    const dt_iop_order_entry_t *e = n->data;
+    if(e->instance != 0) continue;
+    if(!strcmp(e->operation, anchor_op)) { anchor = n; anchor_index = i; }
+    if(!strcmp(e->operation, op)) { node = n; index = i; }
+  }
+  if(!anchor) return;
+  if(!node)
+  {
+    dt_iop_order_entry_t *entry = calloc(1, sizeof(*entry));
+    g_strlcpy(entry->operation, op, sizeof(entry->operation));
+    g_list_insert_before(list, anchor->next, entry);
+  }
+  else if(index < anchor_index)
+  {
+    void *entry = node->data;
+    for(GList *n = node; n != anchor; n = n->next) n->data = n->next->data;
+    anchor->data = entry;
+  }
+}
