+// The early HSV stage is derived from the selected creative profile. It has
+// no independent history/settings. Resolve the last APPLIED history entry on
+// every sync (including undo and export), then hash those exact parameters so
+// an Amount/selection edit invalidates the early cache as well as the late one.
+static void _omaraw_sync_creative_look(dt_dev_pixelpipe_t *pipe, dt_develop_t *dev)
+{
+  dt_dev_pixelpipe_iop_t *early=NULL;
+  for(GList *node=pipe->nodes;node;node=node->next) {
+    dt_dev_pixelpipe_iop_t *piece=node->data;
+    if(dt_iop_module_is(piece->module,"omarawlook")) { early=piece; break; }
+  }
+  if(!early) return;
+  dt_dev_history_item_t *selected=NULL;
+  GList *history=dev->history;
+  for(int k=0;k<dev->history_end && history;++k,history=history->next) {
+    dt_dev_history_item_t *item=history->data;
+    if(dt_iop_module_is(item->module,"omarawprofile")) selected=item;
+  }
+  early->enabled=selected && selected->enabled;
+  early->hash=DT_INVALID_HASH;
+  if(!early->enabled || selected->module->params_size!=early->module->params_size) return;
+  early->module->commit_params(early->module,selected->params,pipe,early);
+  early->hash=dt_hash(DT_INITHASH,selected->params,selected->module->params_size);
+}
