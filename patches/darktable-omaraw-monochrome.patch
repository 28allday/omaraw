+// OmaRAW B&W mix. Classify the original Lab colour in display RGB hue,
+// then smoothly interpolate only the two neighbouring colour controls.
+// Neutral protection avoids amplifying unstable hue in greys and shadows.
+static float _mix_gain(const float *Lab, const float mix[8])
+{
+  const float chroma2 = Lab[1]*Lab[1] + Lab[2]*Lab[2];
+  if(chroma2 <= 4.f || Lab[0] <= 0.f) return 1.f;
+  const dt_aligned_pixel_t lab = {Lab[0], Lab[1], Lab[2], 0.f};
+  dt_aligned_pixel_t xyz, rgb;
+  dt_Lab_to_XYZ(lab, xyz);
+  dt_XYZ_to_sRGB(xyz, rgb);
+  const float lo = fminf(rgb[0], fminf(rgb[1], rgb[2]));
+  const float hi = fmaxf(rgb[0], fmaxf(rgb[1], rgb[2]));
+  const float delta = hi - lo;
+  if(!isfinite(delta) || delta <= 1e-6f) return 1.f;
+  float hue = hi == rgb[0] ? (rgb[1]-rgb[2])/delta
+            : hi == rgb[1] ? 2.f+(rgb[2]-rgb[0])/delta
+                           : 4.f+(rgb[0]-rgb[1])/delta;
+  if(hue < 0.f) hue += 6.f;
+  hue *= 60.f;
+  const float centres[9] = {0.f,30.f,60.f,120.f,180.f,240.f,270.f,300.f,360.f};
+  int band = 0;
+  while(band < 7 && hue > centres[band+1]) band++;
+  float t = CLAMPS((hue-centres[band])/(centres[band+1]-centres[band]),0.f,1.f);
+  t = t*t*(3.f-2.f*t);
+  float protect = CLAMPS((sqrtf(chroma2)-2.f)/10.f,0.f,1.f);
+  protect = protect*protect*(3.f-2.f*protect);
+  const float amount = (1.f-t)*mix[band] + t*mix[(band+1)%8];
+  return exp2f(amount*protect);
 }
 
