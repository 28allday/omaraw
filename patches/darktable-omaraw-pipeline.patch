+int omaraw_chain_describe(dt_iop_module_t *self,
+                          dt_dev_pixelpipe_iop_t *piece,
+                          dt_omaraw_chain_stage_t *stage)
+{
+  const dt_iop_colorin_data_t *const d = piece->data;
+  dt_dev_pixelpipe_t *pipe = piece->pipe;
+  if(!dt_omaraw_ocio_transform || piece->colors != 4 || d->type == DT_COLORSPACE_LAB
+     || !dt_is_valid_colormatrix(d->cmatrix[0][0]) || d->nonlinearlut)
+    return 0;
+  for(int c = 0; c < 3; c++)
+    if(d->lut[c][0] >= 0.0f) return 0;
+  if(d->nrgb && !dt_is_valid_colormatrix(d->nmatrix[0][0])) return 0;
+  const dt_dev_chroma_t *chr = &self->dev->chroma;
+  const gboolean corrected = chr->late_correction && d->type != DT_COLORSPACE_LAB;
+  stage->kind = DT_OMARAW_CHAIN_COLORIN;
+  stage->corrected = corrected;
+  for(int k = 0; k < 4; k++)
+  {
+    stage->coeffs[k] = corrected ? chr->D65coeffs[k] / chr->as_shot[k] : 1.0f;
+    stage->d65[k] = chr->D65coeffs[k];
+  }
+  stage->blue_mapping = d->blue_mapping && dt_image_is_matrix_correction_supported(&pipe->image);
+  stage->clipping = d->nrgb != NULL;
+  dt_omaraw_chain_copy_matrix(stage->matrix, d->nrgb ? d->nmatrix : d->cmatrix);
+  if(d->nrgb) dt_omaraw_chain_copy_matrix(stage->lmatrix, d->lmatrix);
+  return 1;
+}
