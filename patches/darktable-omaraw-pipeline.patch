+/* OmaRAW colour chain. A run of consecutive enabled per-pixel modules ending
+   at the module being processed is handed to the application as one job:
+   on the GPU it is a single resident pass, and when the application
+   declines the run is processed natively here, stage by stage, and offered
+   back with its time so the application can qualify its GPU path. */
+#define OMARAW_CHAIN_MAX 8
+
+static gboolean _omaraw_chain_candidate(const dt_iop_module_t *module,
+                                        const dt_dev_pixelpipe_iop_t *piece)
+{
+  const char *op = module->op;
+  if(strcmp(op, "exposure") && strcmp(op, "colorin")
+     && strcmp(op, "channelmixerrgb") && strcmp(op, "sigmoid"))
+    return FALSE;
+  const dt_develop_blend_params_t *blend = piece->blendop_data;
+  if(blend && blend->mask_mode != DEVELOP_MASK_DISABLED) return FALSE;
+  if(piece->request_histogram & DT_REQUEST_ON) return FALSE;
+  return piece->colors == 4;
+}
+
+static int _omaraw_chain_cancelled(void *request)
+{
+  return _pipe_has_shutdown((dt_dev_pixelpipe_t *)request);
+}
+
+static void _omaraw_chain_side_effects(dt_dev_pixelpipe_t *pipe,
+                                       const dt_omaraw_chain_stage_t *stages,
+                                       const int count)
+{
+  for(int i = 0; i < count; i++)
+  {
+    const dt_omaraw_chain_stage_t *s = &stages[i];
+    if(s->kind == DT_OMARAW_CHAIN_EXPOSURE)
+      for(int k = 0; k < 3; k++) pipe->dsc.processed_maximum[k] *= s->scale;
+    else if(s->kind == DT_OMARAW_CHAIN_COLORIN && s->corrected)
+      for(int k = 0; k < 4; k++)
+      {
+        pipe->dsc.temperature.coeffs[k] = s->d65[k];
+        pipe->dsc.processed_maximum[k] *= s->coeffs[k];
+      }
+  }
+}
+
+// The run processed natively, in the order and with the calls the normal
+// path would make, into `out`. Returns TRUE on a shutdown.
+static gboolean _omaraw_chain_native(dt_dev_pixelpipe_t *pipe,
+                                     GList *first_modules,
+                                     GList *first_pieces,
+                                     GList *last_modules,
+                                     const float *input,
+                                     float *out,
+                                     const dt_iop_roi_t *roi_in,
+                                     const dt_iop_roi_t *roi_out,
+                                     const dt_iop_order_iccprofile_info_t *work_profile,
+                                     const int count)
+{
+  const int w = roi_out->width, h = roi_out->height;
+  float *tmp = count >= 2 ? dt_iop_image_alloc(w, h, 4) : NULL;
+  if(count >= 2 && !tmp) return TRUE;
+  const float *src = input;
+  float *dst = (count & 1) ? out : tmp;
+  dt_iop_colorspace_type_t cst = pipe->dsc.cst;
+  gboolean stop = FALSE;
+  GList *lm = first_modules, *lp = first_pieces;
+  for(;;)
+  {
+    dt_iop_module_t *mod = lm->data;
+    dt_dev_pixelpipe_iop_t *pie = lp->data;
+    if(!_skip_piece_on_tags(pie))
+    {
+      const dt_iop_colorspace_type_t cst_to = mod->input_colorspace(mod, pipe, pie);
+      if(cst != cst_to)
+      {
+        dt_times_t start;
+        dt_get_perf_times(&start);
+        dt_ioppr_transform_image_colorspace(mod, src, dst, w, h, cst, cst_to, &cst, work_profile);
+        dt_show_times_f(&start, "[dev_pixelpipe]", "[%s] processed colorspace %s chain step on CPU",
+                        dt_dev_pixelpipe_type_to_str(pipe->type), mod->op);
+        src = dst; dst = (dst == tmp) ? out : tmp;
+      }
+      dt_times_t start;
+      dt_get_perf_times(&start);
+      mod->process(mod, pie, src, dst, roi_in, roi_out);
+      dt_show_times_f(&start, "[dev_pixelpipe]", "[%s] processed `%s' chain step on CPU",
+                      dt_dev_pixelpipe_type_to_str(pipe->type), mod->op);
+      cst = mod->output_colorspace(mod, pipe, pie);
+      pipe->dsc.cst = cst;
+      if(_module_pipe_stop(pipe, mod, dst) != DT_DEV_PIXELPIPE_STOP_NO) { stop = TRUE; break; }
+      src = dst; dst = (dst == tmp) ? out : tmp;
+    }
+    if(lm == last_modules) break;
+    lm = g_list_next(lm); lp = g_list_next(lp);
+  }
+  dt_free_align(tmp);
+  return stop;
+}
+
+// 1: handled, output filled. 0: not a chain here, continue normally.
+// -1: the pipe was shut down.
+static int _omaraw_chain_process(dt_dev_pixelpipe_t *pipe,
+                                 dt_develop_t *dev,
+                                 void **output,
+                                 void **cl_mem_output,
+                                 dt_iop_buffer_dsc_t **out_format,
+                                 const dt_iop_roi_t *roi_out,
+                                 GList *modules,
+                                 GList *pieces,
+                                 const int pos,
+                                 const dt_hash_t hash,
+                                 const size_t bufsize)
+{
+  if(!dt_omaraw_chain || !modules || !dt_pipe_no_mask_display(pipe)) return 0;
+  // Collect the run backwards from the module being processed.
+  GList *first_modules = NULL, *first_pieces = NULL;
+  int count = 0;
+  for(GList *m = modules, *pc = pieces; m; m = g_list_previous(m), pc = g_list_previous(pc))
+  {
+    dt_dev_pixelpipe_iop_t *pie = pc->data;
+    if(_skip_piece_on_tags(pie)) continue;
+    if(!_omaraw_chain_candidate(m->data, pie)) break;
+    first_modules = m; first_pieces = pc; ++count;
+    if(count >= OMARAW_CHAIN_MAX) break;
+  }
+  if(!count) return 0;
+  int first_pos = pos;
+  for(GList *m = modules; m != first_modules; m = g_list_previous(m)) --first_pos;
+  dt_iop_roi_t roi_in = *roi_out; // every stage is per-pixel
+  void *input = NULL, *cl_mem_input = NULL;
+  dt_iop_buffer_dsc_t _input_format = { 0 };
+  dt_iop_buffer_dsc_t *input_format = &_input_format;
+  if(_dev_pixelpipe_process_rec(pipe, dev, &input, &cl_mem_input, &input_format, &roi_in,
+                                g_list_previous(first_modules), g_list_previous(first_pieces), first_pos - 1))
+    return -1;
+  if(_pipe_has_shutdown(pipe)) return -1;
+  if(cl_mem_input || !input || input_format->cst == IOP_CS_RAW
+     || input_format->channels != 4 || input_format->datatype != TYPE_FLOAT)
+    return 0;
+  const dt_iop_order_iccprofile_info_t *work_profile = dt_ioppr_get_pipe_work_profile_info(pipe);
+  dt_omaraw_chain_stage_t stages[OMARAW_CHAIN_MAX * 2];
+  int n = 0;
+  dt_iop_colorspace_type_t cst = input_format->cst;
+  dt_iop_buffer_dsc_t dsc = *input_format;
+  for(GList *lm = first_modules, *lp = first_pieces;; lm = g_list_next(lm), lp = g_list_next(lp))
+  {
+    dt_iop_module_t *mod = lm->data;
+    dt_dev_pixelpipe_iop_t *pie = lp->data;
+    if(!_skip_piece_on_tags(pie))
+    {
+      const dt_iop_colorspace_type_t cst_to = mod->input_colorspace(mod, pipe, pie);
+      if(cst != cst_to)
+      {
+        if(cst != IOP_CS_LAB || cst_to != IOP_CS_RGB || !work_profile || work_profile->nonlinearlut
+           || !dt_is_valid_colormatrix(work_profile->matrix_out[0][0]))
+          return 0;
+        memset(&stages[n], 0, sizeof stages[n]);
+        stages[n].kind = DT_OMARAW_CHAIN_LAB_TO_RGB;
+        dt_omaraw_chain_copy_matrix(stages[n].matrix, work_profile->matrix_out);
+        ++n;
+        cst = cst_to;
+      }
+      if(!mod->omaraw_chain_describe) return 0;
+      // The chain runs whole images; leave anything darktable would tile to it.
+      dt_develop_tiling_t tiling = { .factor = 2.0f, .factor_cl = 2.0f, .maxbuf = 1.0f, .maxbuf_cl = 1.0f,
+                                     .overhead = 0, .overlap = 0, .align = 1 };
+      mod->tiling_callback(mod, pie, &roi_in, roi_out, &tiling);
+      if(!dt_tiling_piece_fits_host_memory(pie, roi_out->width, roi_out->height, 16, tiling.factor, tiling.overhead))
+        return 0;
+      pie->dsc_in = dsc;
+      pie->dsc_out = dsc;
+      mod->output_format(mod, pipe, pie, &pie->dsc_out);
+      dsc = pie->dsc_out;
+      pie->processed_roi_in = roi_in;
+      pie->processed_roi_out = *roi_out;
+      memset(&stages[n], 0, sizeof stages[n]);
+      if(!mod->omaraw_chain_describe(mod, pie, &stages[n])) return 0;
+      ++n;
+      cst = mod->output_colorspace(mod, pipe, pie);
+    }
+    if(lm == modules) break;
+  }
+  dt_iop_module_t *module = modules->data;
+  **out_format = pipe->dsc = dsc;
+  pipe->dsc.cst = input_format->cst;
+  const gboolean important_out = dt_pipe_is_screen(pipe) && (module->flags() & IOP_FLAGS_WRITE_PIPECACHE);
+  dt_dev_pixelpipe_cache_get(pipe, hash, bufsize, output, out_format, module, important_out);
+  *cl_mem_output = NULL;
+  const int w = roi_out->width, h = roi_out->height;
+  dt_times_t start;
+  dt_get_perf_times(&start);
+  const int done = dt_omaraw_chain(stages, n, (const float *)input, (float *)*output, w, h, -1.0,
+                                   _omaraw_chain_cancelled, pipe);
+  if(_pipe_has_shutdown(pipe)) return -1;
+  if(done)
+  {
+    _omaraw_chain_side_effects(pipe, stages, n);
+    pipe->dsc.cst = cst;
+    dt_show_times_f(&start, "[dev_pixelpipe]", "[%s] processed `%s' chain of %d on OmaRAW GPU",
+                    dt_dev_pixelpipe_type_to_str(pipe->type), module->op, n);
+    return 1;
+  }
+  if(_omaraw_chain_native(pipe, first_modules, first_pieces, modules, (const float *)input,
+                          (float *)*output, &roi_in, roi_out, work_profile, n))
+    return -1;
+  const double native_ms = dt_get_lap_time(&start.clock) * 1000.0;
+  dt_omaraw_chain(stages, n, (const float *)input, (float *)*output, w, h, native_ms,
+                  _omaraw_chain_cancelled, pipe);
+  return _pipe_has_shutdown(pipe) ? -1 : 1;
+}
