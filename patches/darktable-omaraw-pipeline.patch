+    dt_omaraw_chain_copy_matrix(stage->pipe_to_base, pipe_to_base);
+    dt_omaraw_chain_copy_matrix(stage->base_to_rendering, base_to_rendering);
+    dt_omaraw_chain_copy_matrix(stage->rendering_to_pipe, rendering_to_pipe);
+  }
