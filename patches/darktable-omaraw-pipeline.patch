+// OmaRAW optional colour chain ABI 1. A run of consecutive per-pixel modules
+// between demosaic and colorout (exposure, colorin, the implicit Lab-to-RGB
+// step, channelmixerrgb, sigmoid) is described so the application can run
+// it as one resident GPU pass instead of four full-size CPU passes and two
+// colour-space transforms. Registered before any image is processed.
+#pragma once
+#include <string.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum
+{
+  DT_OMARAW_CHAIN_EXPOSURE = 1,
+  DT_OMARAW_CHAIN_COLORIN = 2,
+  DT_OMARAW_CHAIN_LAB_TO_RGB = 3,
+  DT_OMARAW_CHAIN_CHANNELMIXER = 4,
+  DT_OMARAW_CHAIN_SIGMOID = 5
+};
+
+// Every matrix is row-major 3x4 with the fourth column unused, as the
+// engine's own OpenCL kernels take them: out.r = m[0]*r + m[1]*g + m[2]*b.
+typedef struct dt_omaraw_chain_stage_t
+{
+  int kind;
+  // exposure: out = (in - black) * scale
+  float black, scale;
+  // colorin: multiply by coeffs unless blue mapping, optional blue mapping,
+  // matrix (camera to XYZ, or to a clipping RGB followed by a clamp to [0,1]
+  // and lmatrix to XYZ), then XYZ to Lab. `corrected` and `d65` carry the
+  // pipe state the module would have set.
+  float coeffs[4];
+  int blue_mapping, clipping, corrected;
+  float d65[4];
+  float matrix[12];
+  float lmatrix[12];
+  // lab_to_rgb: Lab to XYZ then `matrix` (the work profile's XYZ to RGB)
+  // channelmixer: darktable's channelmixerrgb kernels, argument for argument
+  int adaptation, version, clip, apply_grey;
+  float rgb_to_xyz[12], xyz_to_rgb[12], mix[12];
+  float illuminant[4], saturation[4], lightness[4], grey[4];
+  float p, gamut;
+  // sigmoid: method 0 per channel (with the three primaries matrices),
+  // 1 RGB ratio
+  int method;
+  float white_target, black_target, paper_exposure, film_fog, film_power, paper_power, hue_preservation;
+  float pipe_to_base[12], base_to_rendering[12], rendering_to_pipe[12];
+} dt_omaraw_chain_stage_t;
+
+// Negative cpu_ms attempts the GPU; positive offers a completed native
+// reference and its time. Return 1 only when output was supplied or the
+// request was cancelled. `cancelled` may be polled with `request`.
+typedef int (*dt_omaraw_chain_callback)(const dt_omaraw_chain_stage_t *stages, int count,
+                                        const float *input, float *output, int width, int height,
+                                        double cpu_ms, int (*cancelled)(void *), void *request);
+extern dt_omaraw_chain_callback dt_omaraw_chain;
+void dt_omaraw_set_chain(dt_omaraw_chain_callback callback);
+
+// Each chain module exports `omaraw_chain_describe` from its plugin: fill the
+// stage from the committed piece, or return 0 when the current parameters
+// have no chain equivalent and the module must run natively.
+struct dt_iop_module_t;
+struct dt_dev_pixelpipe_iop_t;
+typedef int (*dt_omaraw_chain_describe_fn)(struct dt_iop_module_t *self,
+                                           struct dt_dev_pixelpipe_iop_t *piece,
+                                           dt_omaraw_chain_stage_t *stage);
+
+static inline void dt_omaraw_chain_copy_matrix(float out[12], const float in[4][4])
+{
+  for(int r = 0; r < 3; r++)
+    for(int c = 0; c < 4; c++) out[r * 4 + c] = in[r][c];
+}
+
+#ifdef __cplusplus
+}
+#endif
