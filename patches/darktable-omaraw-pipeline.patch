+// OmaRAW colour chain: the kernel arguments process_cl() would pass, after
+// the same runtime camera-illuminant update process() makes.
+int omaraw_chain_describe(dt_iop_module_t *self,
+                          dt_dev_pixelpipe_iop_t *piece,
+                          dt_omaraw_chain_stage_t *stage)
+{
+  dt_iop_channelmixer_rbg_data_t *const d = piece->data;
+  const dt_iop_order_iccprofile_info_t *const work_profile =
+    dt_ioppr_get_pipe_current_profile_info(self, piece->pipe);
+  if(!work_profile || piece->colors != 4 || (self->dev->gui_attached && self->gui_data))
+    return 0;
+  if(!dt_is_valid_colormatrix(work_profile->matrix_in[0][0])
+     || !dt_is_valid_colormatrix(work_profile->matrix_out[0][0]))
+    return 0;
+  if(dt_pipe_is_preview(piece->pipe))
+    _declare_cat_on_pipe(self, FALSE);
+  if(d->illuminant_type == DT_ILLUMINANT_CAMERA)
+  {
+    float x, y;
+    dt_aligned_pixel_t custom_wb;
+    _get_white_balance_coeff(self, custom_wb);
+    if(find_temperature_from_raw_coeffs(&(self->dev->image_storage), custom_wb, &(x), &(y)))
+    {
+      dt_aligned_pixel_t XYZ;
+      illuminant_xy_to_XYZ(x, y, XYZ);
+      convert_any_XYZ_to_LMS(XYZ, d->illuminant, d->adaptation);
+      d->illuminant[3] = 0.f;
+    }
+  }
+  stage->kind = DT_OMARAW_CHAIN_CHANNELMIXER;
+  stage->adaptation = d->adaptation;
+  stage->version = d->version;
+  stage->clip = d->clip;
+  stage->apply_grey = d->apply_grey;
+  stage->p = d->p;
+  stage->gamut = d->gamut;
+  dt_omaraw_chain_copy_matrix(stage->rgb_to_xyz, work_profile->matrix_in);
+  dt_omaraw_chain_copy_matrix(stage->xyz_to_rgb, work_profile->matrix_out);
+  dt_omaraw_chain_copy_matrix(stage->mix, d->MIX);
+  for(int k = 0; k < 4; k++)
+  {
+    stage->illuminant[k] = d->illuminant[k];
+    stage->saturation[k] = d->saturation[k];
+    stage->lightness[k] = d->lightness[k];
+    stage->grey[k] = d->grey[k];
+  }
+  return 1;
+}
