+// Use the same centred CFA footprint for live reduced mosaics and stored
+// Smart Previews. Integer CFA-block bounds otherwise move their sample grid.
+static void _omaraw_reduce_mosaic(void *out, const void *input, int width, int height,
+                                int out_width, int out_height, float scale,
+                                int out_stride, int in_stride, uint32_t filters,
+                                const uint8_t (*xtrans)[6], gboolean floating) {
+    const double step = 1.0 / scale;
+    DT_OMP_FOR()
+    for (int y = 0; y < out_height; y++) {
+        const double top = (y - .5) * step + .5, bottom = (y + .5) * step + .5;
+        const int y0 = MAX(0, (int)floor(top)), y1 = MIN(height, (int)ceil(bottom));
+        for (int x = 0; x < out_width; x++) {
+            const double left = (x - .5) * step + .5, right = (x + .5) * step + .5;
+            const int x0 = MAX(0, (int)floor(left)), x1 = MIN(width, (int)ceil(right));
+            const int colour = xtrans ? xtrans[y % 6][x % 6] : FC(y, x, filters);
+            double sum = 0.0, weight = 0.0;
+            for (int sy = y0; sy < y1; sy++) {
+                const double wy = MIN(bottom, sy + 1.0) - MAX(top, sy);
+                for (int sx = x0; sx < x1; sx++) {
+                    const int c = xtrans ? xtrans[sy % 6][sx % 6] : FC(sy, sx, filters);
+                    if (c != colour) continue;
+                    const double w = wy * (MIN(right, sx + 1.0) - MAX(left, sx));
+                    const size_t index = (size_t)sy * in_stride + sx;
+                    sum += w * (floating ? ((const float *)input)[index] : ((const uint16_t *)input)[index]);
+                    weight += w;
+                }
+            }
+            // A narrow X-Trans footprint can contain no site of this colour.
+            // Use the nearest matching photosite instead of inserting black.
+            if (weight == 0.0) {
+                const int cx = CLAMP((int)round(x * step), 0, width - 1);
+                const int cy = CLAMP((int)round(y * step), 0, height - 1);
+                double best = G_MAXDOUBLE;
+                for (int sy = MAX(0, cy - 6); sy <= MIN(height - 1, cy + 6); ++sy)
+                    for (int sx = MAX(0, cx - 6); sx <= MIN(width - 1, cx + 6); ++sx) {
+                        const int c = xtrans ? xtrans[sy % 6][sx % 6] : FC(sy, sx, filters);
+                        const double distance = (sx - x * step) * (sx - x * step) + (sy - y * step) * (sy - y * step);
+                        if (c != colour || distance >= best) continue;
+                        best = distance;
+                        const size_t i = (size_t)sy * in_stride + sx;
+                        sum = floating ? ((const float *)input)[i] : ((const uint16_t *)input)[i];
+                        weight = 1.0;
+                    }
+            }
+            const size_t index = (size_t)y * out_stride + x;
+            if (floating) ((float *)out)[index] = weight > 0.0 ? sum / weight : 0.0;
+            else ((uint16_t *)out)[index] = weight > 0.0 ? (uint16_t)round(sum / weight) : 0;
+        }
+    }
+}
