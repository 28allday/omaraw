 static inline void _print(const omaraw_print_tables_t *t, const float trim[3], const float gain[3], const float p[3], float light[3]);
 
+// The approximate spectral model has a blue/yellow crossover even on an
+// achromatic scene. Calibrate its neutral axis without replacing the film's
+// luminance curve or its response to chromatic inputs. This is a display
+// correction, not a claim of measured spectral accuracy (PRINT-STOCKS, 15).
+static inline float _luminance(const float p[3])
+{
+  return 0.2627f * p[0] + 0.6780f * p[1] + 0.0593f * p[2];
+}
+
+static void _neutral_balance(dt_iop_omarawprint_data_t *d)
+{
+  float axis[OMARAW_PRINT_BALANCE_SAMPLES][4];
+  const float none[3] = {0, 0, 0}, unit[3] = {1, 1, 1};
+  for(int i = 0; i < OMARAW_PRINT_BALANCE_SAMPLES; i++)
+  {
+    const float v = exp2f(-20.0f + 40.0f * i / (OMARAW_PRINT_BALANCE_SAMPLES - 1));
+    const float grey[3] = {v, v, v};
+    float light[3];
+    _print(d->tables, none, unit, grey, light);
+    const float y = _luminance(light);
+    axis[i][0] = log2f(fmaxf(y, 0x1p-16f));
+    // Quantisation can create tiny plateaus. Keep the inverse axis monotone.
+    if(i) axis[i][0] = fmaxf(axis[i][0], axis[i-1][0]);
+    for(int c = 0; c < 3; c++) axis[i][c+1] = y / fmaxf(light[c], 0x1p-16f);
+  }
+  int j = 0;
+  for(int i = 0; i < OMARAW_PRINT_BALANCE_SAMPLES; i++)
+  {
+    const float x = -16.0f + 16.0f * i / (OMARAW_PRINT_BALANCE_SAMPLES - 1);
+    while(j < OMARAW_PRINT_BALANCE_SAMPLES - 2 && axis[j+1][0] < x) j++;
+    const float span = axis[j+1][0] - axis[j][0];
+    const float f = span > 1e-8f ? CLAMP((x - axis[j][0]) / span, 0.0f, 1.0f) : 0.0f;
+    for(int c = 0; c < 3; c++) d->balance[i][c] = axis[j][c+1] * (1-f) + axis[j+1][c+1] * f;
+  }
+}
+
+static inline void _balance(const dt_iop_omarawprint_data_t *d, float light[3])
+{
+  const float y = _luminance(light);
+  const float x = CLAMP((log2f(fmaxf(y, 0x1p-16f)) + 16.0f) / 16.0f, 0.0f, 1.0f)
+                  * (OMARAW_PRINT_BALANCE_SAMPLES - 1);
+  const int i = MIN((int)x, OMARAW_PRINT_BALANCE_SAMPLES - 2);
+  const float f = x - i;
+  for(int c = 0; c < 3; c++) light[c] *= d->balance[i][c] * (1-f) + d->balance[i+1][c] * f;
+  // Retain the film's luminance for coloured pixels as well as neutrals.
+  const float scale = y / fmaxf(_luminance(light), 0x1p-24f);
+  for(int c = 0; c < 3; c++) light[c] *= scale;
+}
