+// A fallback decoder can unpack a new camera before its own coefficient
+// table knows that model. Reuse the same camera matrix as native RawSpeed.
+gboolean dt_rawspeed_lookup_color_matrix(const char *maker, const char *model, float matrix[4][3])
+{
+  try
+  {
+    dt_rawspeed_load_meta();
+    const Camera *cam = meta->getCamera(maker, model);
+    if(!cam || (cam->color_matrix.size() != 9 && cam->color_matrix.size() != 12)) return FALSE;
+    for(int k = 0; k < 4; k++)
+      for(int i = 0; i < 3; i++)
+        matrix[k][i] = size_t(3 * k + i) < cam->color_matrix.size()
+          ? float(cam->color_matrix[3 * k + i]) : 0.0f;
+    return TRUE;
+  }
+  catch(const std::exception &exc)
+  {
+    dt_print(DT_DEBUG_ALWAYS, "[rawspeed] camera matrix lookup: %s", exc.what());
+    return FALSE;
+  }
 }
 
