+// A baked OmaRAW DNG stores linear sRGB, with white balance and tone already
+// applied. It remains a genuine three-plane DNG but must not acquire a second
+// camera workflow when imported into a fresh catalogue or reset to defaults.
+static bool _omaraw_rendered_dng(const char *filename)
+{
+  try
+  {
+    auto file = Exiv2::ImageFactory::open(filename);
+    if(!file) return false;
+    file->readMetadata();
+    const auto &exif = file->exifData();
+    auto model = exif.findKey(Exiv2::ExifKey("Exif.Image.UniqueCameraModel"));
+    auto software = exif.findKey(Exiv2::ExifKey("Exif.Image.Software"));
+    return model != exif.end() && model->toString() == "OmaRAW rendered sRGB"
+      && software != exif.end() && software->toString().find("OmaRAW") == 0
+      && software->toString().find("AI removal") != std::string::npos;
+  }
+  catch(const std::exception &) { return false; }
+}
