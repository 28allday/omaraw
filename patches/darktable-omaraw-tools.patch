+  // OmaRAW's content-addressed masks travel beside the engine library.
+  // Resolve there first so restored history works without rewriting edits.
+  gboolean managed = strlen(p->file) == 68 && !strcmp(p->file + 64, ".png");
+  for(int i = 0; managed && i < 64; ++i)
+    managed = (p->file[i] >= '0' && p->file[i] <= '9')
+           || (p->file[i] >= 'a' && p->file[i] <= 'f');
+  if(managed && darktable.db)
+  {
+    gchar *library = g_path_get_dirname(dt_database_get_path(darktable.db));
+    gchar *local = g_build_filename(library, "masks", p->file, NULL);
+    if(g_file_test(local, G_FILE_TEST_IS_REGULAR))
+    {
+      g_free(fullpath);
+      fullpath = local;
+    }
+    else g_free(local);
+    g_free(library);
+  }
   dt_strlcpy_to_fixed(d->filepath, fullpath, sizeof(d->filepath));
   g_free(fullpath);
