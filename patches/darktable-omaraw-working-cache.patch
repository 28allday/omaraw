+static void *(*working_allocate)(size_t);
+static void (*working_release)(void *);
+static int (*working_prepare)(const void *, size_t, void *, size_t);
+void dt_omaraw_working_cache_callbacks(void *(*allocate)(size_t), void (*release)(void *),
+                                      int (*prepare)(const void *, size_t, void *, size_t))
+{
+  working_allocate = allocate;
+  working_release = release;
+  working_prepare = prepare;
+}
+int dt_omaraw_working_prepare(const void *input, size_t input_bytes, void *output, size_t anticipated)
+{
+  return working_prepare ? working_prepare(input, input_bytes, output, anticipated) : 1;
+}
+static void *working_alloc(size_t bytes)
+{
+  return working_allocate ? working_allocate(bytes) : dt_alloc_aligned(bytes);
+}
+static void working_free(void *pixels)
+{
+  if(working_release) working_release(pixels);
+  else dt_free_align(pixels);
+}
 
