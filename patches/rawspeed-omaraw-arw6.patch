+    mRaw->createData();
+
+    d.decompress();
+
+    rawspeed::MSan::CheckMemIsInitialized(
+        mRaw->getByteDataAsUncroppedArray2DRef());
+  } catch (const rawspeed::RawspeedException&) { // NOLINT(bugprone-empty-catch)
+    // Exceptions are good, crashes are bad.
+  }
+
+  return 0;
+}
