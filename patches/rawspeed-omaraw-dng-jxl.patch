+// OmaRAW JPEG XL DNG integration; developed with AI assistance for local review.
+template <> void AbstractDngDecompressor::decompressThread<52546>() const noexcept {
+#ifdef HAVE_OPENMP
+#pragma omp for schedule(static)
+#endif
+  for (const auto& e : Array1DRef(slices.data(), implicit_cast<int>(slices.size()))) {
+    try {
+      const auto input = e.bs.peekBuffer(e.bs.getRemainSize());
+      const bool floating = mRaw->getDataType() == RawImageType::F32;
+      std::vector<uint8_t> decoded;
+      if (!oma_dng::decodeJxl(input.begin(), input.getSize(), e.dsc.tileW, e.dsc.tileH,
+                             mRaw->getCpp(), mBps, floating, decoded))
+        ThrowRDE("Invalid or unsupported JPEG XL DNG tile");
+      const size_t cpp = mRaw->getCpp();
+      const size_t sampleSize = floating ? sizeof(float) : sizeof(uint16_t);
+      for (unsigned y = 0; y < e.height; ++y) {
+        void* target = floating
+            ? static_cast<void*>(&mRaw->getF32DataAsUncroppedArray2DRef()(e.offY+y, e.offX*cpp))
+            : static_cast<void*>(&mRaw->getU16DataAsUncroppedArray2DRef()(e.offY+y, e.offX*cpp));
+        memcpy(target, decoded.data()+y*e.dsc.tileW*cpp*sampleSize, e.width*cpp*sampleSize);
+      }
+    } catch (const std::exception& err) {
+      mRaw->setError(err.what());
+    } catch (...) {
+      mRaw->setError("JPEG XL DNG decoding failed");
+    }
+  }
+}
